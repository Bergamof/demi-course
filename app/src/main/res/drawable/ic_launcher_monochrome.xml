<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon layer (Android 13+): the launcher keeps only the alpha and tints it
     from the wallpaper. Same track as the foreground, with full alpha for the first half
     and the marker, 30% for the rest. The halves stop short of the marker instead of
     being outlined by a background-colored ring, which a single-tone layer can't draw. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="56"
        android:rotation="-20">
        <!-- Inner lane -->
        <path
            android:pathData="M34,56 A20,8 0 1,0 74,56 A20,8 0 1,0 34,56 Z"
            android:strokeAlpha="0.3"
            android:strokeColor="#ffffff"
            android:strokeWidth="2" />
        <!-- Second half of the lap -->
        <path
            android:pathData="M77.88,65.68 A30,16 0 0,1 24,56"
            android:strokeAlpha="0.3"
            android:strokeColor="#ffffff"
            android:strokeLineCap="round"
            android:strokeWidth="8" />
        <!-- First half of the lap -->
        <path
            android:pathData="M24,56 A30,16 0 0,1 77.88,46.32"
            android:strokeColor="#ffffff"
            android:strokeLineCap="round"
            android:strokeWidth="8" />
        <!-- Halfway marker -->
        <path
            android:fillColor="#ffffff"
            android:pathData="M78,56 A6,6 0 1,0 90,56 A6,6 0 1,0 78,56 Z" />
    </group>
</vector>
