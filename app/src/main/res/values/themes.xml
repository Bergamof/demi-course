<resources>
    <!-- The activity's window theme only; all real theming (light/dark/system, colors)
         is handled in Compose — see ui/theme/Theme.kt, which also drives the system-bar
         icon appearance at runtime from the in-app theme choice. -->
    <style name="Theme.DemiCourse" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
